#!/bin/bash

# Color codes for better UX
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Auto-detect JAR file from target directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR=$(find "$SCRIPT_DIR/target" -name "yang-compiler-*.jar" 2>/dev/null | sort -V | tail -n 1)

# Function to print colored messages
print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_header() {
    echo -e "${BOLD}${CYAN}$1${NC}"
}

# Help command (no JAR needed)
if [ "$1" = "help" ] || [ "$1" = "--help" ]; then
  cat <<EOF
Usage: ./yangc <command> [options]

Commands:
  init                    Scaffold a new YANG compiler project in the current directory.
                          Creates a 'yang' directory, a default build.json, and a default
                          settings.json.
  compile <inputs...>     Zero-config compilation. Each input can be:
                            - A directory path (e.g. ./yang)
                            - A .yang file path (e.g. my-model.yang)
                            - A module name (e.g. ietf-interfaces)
                            - A module name with revision (e.g. ietf-interfaces@2018-02-20)
                          Multiple inputs are allowed.
    --plugin <name>       Plugin to use (default: validator_plugin).
                          Only one --plugin is allowed; for multiple plugins use build.json.
    --param key=value     Plugin parameter. May be repeated.
  help, --help            Show this help message.
  <other>                 All other arguments are forwarded directly to the YANG compiler:
                            java -jar $JAR [args...]

Examples:
  ./yangc init
  ./yangc compile ./yang
  ./yangc compile ietf-interfaces
  ./yangc compile ietf-interfaces@2018-02-20 --plugin yangtree_generator --param output=tree
EOF
  exit 0
fi

# Init command (no JAR needed)
if [ "$1" = "init" ]; then
  print_header "Initializing YANG Compiler Project"
  echo ""

  # Create yang directory
  if [ -d "yang" ]; then
    print_warning "Directory yang/ already exists, skipping."
  else
    mkdir yang
    print_success "Created directory: yang/"
  fi

  # Generate default build.json
  if [ -f "build.json" ]; then
    print_warning "build.json already exists, skipping."
  else
    cat > build.json <<'BUILDJSON'
{
  "yang": {
    "dir": [
      "yang"
    ]
  },
  "plugin": [
    {
      "name": "validator_plugin",
      "parameter": [
        {
          "name": "output",
          "value": "yang/validator.txt"
        }
      ]
    }
  ]
}
BUILDJSON
    print_success "Created: build.json"
  fi

  # Generate default settings.json
  if [ -f "settings.json" ]; then
    print_warning "settings.json already exists, skipping."
  else
    cat > settings.json <<'SETTINGSJSON'
{
  "settings": {
    "local-repository": "~/.yang",
    "remote-repository": "https://yangcatalog.org/api/"
  }
}
SETTINGSJSON
    print_success "Created: settings.json"
  fi

  echo ""
  print_success "Project initialized successfully!"
  print_info "Place your YANG files in the 'yang/' directory and run './yangc compile ./yang' to compile."
  exit 0
fi

# Compile command (zero-config, supports multiple inputs and optional --plugin / --param)
if [ "$1" = "compile" ]; then
  shift

  if [ $# -eq 0 ]; then
    print_error "'compile' requires at least one input (file, directory, or module name)."
    echo "Usage: ./yangc compile <inputs...> [--plugin <name>] [--param key=value ...]"
    exit 1
  fi

  PLUGIN=""
  PLUGIN_COUNT=0
  PARAMS=()
  INPUTS=()

  # Parse arguments: collect inputs and options
  while [ $# -gt 0 ]; do
    case "$1" in
      --plugin)
        PLUGIN_COUNT=$((PLUGIN_COUNT + 1))
        if [ "$PLUGIN_COUNT" -gt 1 ]; then
          print_error "Only one --plugin is allowed in quick CLI mode."
          print_info "For multiple plugins, use a build.json file and run: ./yangc option=build.json"
          exit 1
        fi
        if [ -z "$2" ]; then
          print_error "--plugin requires a value."
          exit 1
        fi
        PLUGIN="$2"
        shift 2
        ;;
      --param)
        if [ -z "$2" ]; then
          print_error "--param requires a key=value argument."
          exit 1
        fi
        PARAMS+=("$2")
        shift 2
        ;;
      *)
        INPUTS+=("$1")
        shift
        ;;
    esac
  done

  if [ ${#INPUTS[@]} -eq 0 ]; then
    print_error "'compile' requires at least one input (file, directory, or module name)."
    echo "Usage: ./yangc compile <inputs...> [--plugin <name>] [--param key=value ...]"
    exit 1
  fi

  [ -z "$PLUGIN" ] && PLUGIN="validator_plugin"

  if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
    print_error "No JAR file found in target/ directory."
    print_info "Please build the project first by running: mvn clean package"
    exit 1
  fi

  # Show compilation info
  print_header "YANG Compiler"
  echo ""
  print_info "Inputs: ${INPUTS[*]}"
  print_info "Plugin: $PLUGIN"
  if [ ${#PARAMS[@]} -gt 0 ]; then
    print_info "Parameters: ${PARAMS[*]}"
  fi
  echo ""
  print_info "Compiling..."
  echo ""

  TEMP_BUILD=$(mktemp "${TMPDIR:-/tmp}/temp-build-XXXXXX.json")

  # Categorise each input as directory, file, or module name
  DIR_LIST=()
  FILE_LIST=()
  MODULE_LIST=()

  for INPUT in "${INPUTS[@]}"; do
    if [ -d "$INPUT" ]; then
      ESCAPED=$(printf '%s' "$INPUT" | sed 's/\\/\\\\/g; s/"/\\"/g')
      DIR_LIST+=("\"$ESCAPED\"")
    elif [ -f "$INPUT" ]; then
      ESCAPED=$(printf '%s' "$INPUT" | sed 's/\\/\\\\/g; s/"/\\"/g')
      FILE_LIST+=("\"$ESCAPED\"")
    elif [[ "$INPUT" == *.yang ]]; then
      print_error "File not found: $INPUT"
      rm -f "$TEMP_BUILD"
      exit 1
    else
      # Treat as module name, optionally with @revision
      if [[ "$INPUT" == *@* ]]; then
        MOD_NAME="${INPUT%%@*}"
        MOD_REV="${INPUT#*@}"
      else
        MOD_NAME="$INPUT"
        MOD_REV=""
      fi
      MOD_NAME_ESC=$(printf '%s' "$MOD_NAME" | sed 's/\\/\\\\/g; s/"/\\"/g')
      MOD_REV_ESC=$(printf '%s' "$MOD_REV" | sed 's/\\/\\\\/g; s/"/\\"/g')
      MODULE_LIST+=("{\"name\":\"$MOD_NAME_ESC\",\"revision\":\"$MOD_REV_ESC\"}")
    fi
  done

  # Build the "yang" section of the JSON
  YANG_PARTS=()
  [ ${#DIR_LIST[@]} -gt 0 ] && YANG_PARTS+=("\"dir\":[$(IFS=','; echo "${DIR_LIST[*]}")]")
  [ ${#FILE_LIST[@]} -gt 0 ] && YANG_PARTS+=("\"file\":[$(IFS=','; echo "${FILE_LIST[*]}")]")
  [ ${#MODULE_LIST[@]} -gt 0 ] && YANG_PARTS+=("\"module\":[$(IFS=','; echo "${MODULE_LIST[*]}")]")
  YANG_JSON=$(IFS=','; echo "${YANG_PARTS[*]}")

  # Build plugin parameters JSON
  PARAM_ENTRIES=()
  for PARAM in "${PARAMS[@]}"; do
    PKEY="${PARAM%%=*}"
    PVAL="${PARAM#*=}"
    PKEY_ESC=$(printf '%s' "$PKEY" | sed 's/\\/\\\\/g; s/"/\\"/g')
    PVAL_ESC=$(printf '%s' "$PVAL" | sed 's/\\/\\\\/g; s/"/\\"/g')
    PARAM_ENTRIES+=("{\"name\":\"$PKEY_ESC\",\"value\":\"$PVAL_ESC\"}")
  done

  # Build plugin JSON; when no --param given and using the default plugin, add the default output param
  PLUGIN_ESC=$(printf '%s' "$PLUGIN" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [ ${#PARAM_ENTRIES[@]} -gt 0 ]; then
    PARAM_JSON=$(IFS=','; echo "${PARAM_ENTRIES[*]}")
    PLUGIN_JSON="{\"name\":\"$PLUGIN_ESC\",\"parameter\":[$PARAM_JSON]}"
  elif [ "$PLUGIN" = "validator_plugin" ]; then
    PLUGIN_JSON="{\"name\":\"$PLUGIN_ESC\",\"parameter\":[{\"name\":\"output\",\"value\":\"validator.txt\"}]}"
  else
    PLUGIN_JSON="{\"name\":\"$PLUGIN_ESC\"}"
  fi

  # Write the temporary build configuration
  printf '{\n  "yang": {%s},\n  "plugin": [%s]\n}\n' "$YANG_JSON" "$PLUGIN_JSON" > "$TEMP_BUILD"

  java -jar "$JAR" "option=$TEMP_BUILD"
  EXIT_CODE=$?
  rm -f "$TEMP_BUILD"
  
  if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    print_success "Compilation completed successfully!"
  else
    echo ""
    print_error "Compilation failed with exit code: $EXIT_CODE"
  fi
  
  exit $EXIT_CODE
fi

# All other commands require the JAR
if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
  print_error "No JAR file found in target/ directory."
  print_info "Please build the project first by running: mvn clean package"
  exit 1
fi

# Default: forward all arguments to the YANG compiler
exec java -jar "$JAR" "$@"
